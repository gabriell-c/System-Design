# Archia Backend — copy to `.env` and fill in real values.
# NEVER commit `.env` with secrets.

# Database
# Dev (default): SQLite file
DATABASE_URL=sqlite:///./data/app.db
# Docker / staging / prod example:
# DATABASE_URL=postgresql+psycopg2://archia:CHANGE_ME@localhost:5433/archia

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3015,http://127.0.0.1:3015

# JWT Secret (REQUIRED for production — min 32 random chars)
ARCHIA_JWT_SECRET=your-very-long-random-secret-here-at-least-32-chars

# Environment: development | production
ARCHIA_ENV=development

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Optional OmniRoute / LLM provider
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=local
OMNIROUTE_MODEL=auto/coding
OMNIROUTE_TIMEOUT_S=45
