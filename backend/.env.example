# Archia Backend Environment Variables

# Database (default: sqlite)
DATABASE_URL=sqlite:///./data/app.db

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3015,http://127.0.0.1:3015

# JWT Secret (REQUIRED for production - change this!)
ARCHIA_JWT_SECRET=your-very-long-random-secret-here-at-least-32-chars

# Environment: development | production
# production enables secure cookies (HTTPS-only)
ARCHIA_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
